# ─── Application ──────────────────────────────────────────────────────
NODE_ENV=production

# Public URL of the deployed app (must match DOMAIN, scheme https).
NEXTAUTH_URL=https://spp.example.sch.id

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Domain that Caddy will issue a Let's Encrypt cert for.
# DNS A/AAAA record must point to this VPS before first `docker compose up`.
DOMAIN=spp.example.sch.id

# ─── Database ─────────────────────────────────────────────────────────
# DATABASE_URL hostname is `db` — the compose service name.
DATABASE_URL=postgresql://spp:CHANGE_ME_STRONG_PASSWORD@db:5432/spp
POSTGRES_USER=spp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=spp

# ─── Logging ──────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Seed (hanya dipakai saat `prisma db seed` / `tsx prisma/seed.ts`) ─
# Min 12 karakter. WAJIB diganti sebelum go-live. Hapus dari env setelah
# seed pertama selesai supaya tidak tersimpan di server.
SEED_SUPERADMIN_PASSWORD=change-me-strong-password
SEED_BENDAHARA_PASSWORD=change-me-strong-password
