# Database
# connection_limit: naikkan untuk konkuren import+list. Default Prisma = num_cpus*2+1.
# pool_timeout: detik menunggu koneksi bebas sebelum error.
DATABASE_URL="postgresql://spp:spp@localhost:5432/spp?schema=public&connection_limit=20&pool_timeout=10"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Runtime
NODE_ENV="development"
LOG_LEVEL="info"

# Prisma slow-query threshold (ms). Query lebih lama dari ini di-log ke pino (warn).
PRISMA_SLOW_QUERY_MS="500"
